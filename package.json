{
  "name": "webpagetoepub",
  "version": "1.0.0",
  "description": "Convert any webpage to an EPUB file",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack",
    "dev": "concurrently -k -n build,serve -c blue,green \"nodemon --watch src --watch assets --ext ts,js,html,css,png,jpg,gif,ico,xml,webmanifest --exec \\\"npm run build\\\"\" \"http-server dist -c-1 -p 8080\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.js\"",
    "lint": "eslint src *.js *.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webpagetoepub/webpagetoepub.github.io.git"
  },
  "author": "Carlson Santana Cruz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webpagetoepub/webpagetoepub.github.io/issues"
  },
  "homepage": "https://github.com/webpagetoepub/webpagetoepub.github.io#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.11.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.6",
    "http-server": "^14.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.7",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.9",
    "purgecss-webpack-plugin": "^8.0.0",
    "terser-webpack-plugin": "^5.4.0",
    "ts-loader": "^9.5.7",
    "typescript": "^4.9.4",
    "typescript-eslint": "^8.71.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "html2epub": "github:webpagetoepub/html2epub#665e733f080af8e5526a07eae6303c202f7a26ad"
  }
}
